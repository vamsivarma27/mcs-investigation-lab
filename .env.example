# Choose openrouter for real agents; mock is an explicitly labeled offline test mode.
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
INVESTIGATOR_MODEL=google/gemini-3-flash-preview
DECISION_MODEL=~typesafe/jev-latest
JEV_ENABLED=false
DATABASE_PATH=./lab.sqlite3
MAX_MODEL_CALLS=90
MAX_TOOL_CALLS_PER_AGENT=24
MAX_TOTAL_AGENTS=9
MAX_WORKERS_PER_LEAD=2
MAX_DELEGATION_DEPTH=2
MAX_COST_USD=5
